generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Activity {
  id          Int      @id @default(autoincrement())
  userId      String
  description String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model CourseProgress {
  id       Int    @id @default(autoincrement())
  userId   String
  courseId Int
  progress Int    @default(0)

  Course Course @relation(fields: [courseId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

model SimulatorProgress {
  id          Int    @id @default(autoincrement())
  userId      String
  simulatorId Int
  bestScore   Int    @default(0)

  Simulator Simulator @relation(fields: [simulatorId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
}

model Course {
  id             Int              @id @default(autoincrement())
  title          String
  description    String
  category       String
  createdAt      DateTime         @default(now())
  CourseProgress CourseProgress[]
}


model Simulator {
  id                Int                 @id @default(autoincrement())
  title             String
  description       String
  SimulatorProgress SimulatorProgress[]
}

model User {
  id                String              @id @default(cuid())
  name              String?
  firstName         String?
  lastName          String?
  email             String?             @unique
  emailVerified     DateTime?
  password          String?
  role              String              @default("student")
  phone             String?
  birthDate         DateTime?
  image             String?
  googleId          String?             @unique
  createdAt         DateTime            @default(now())

  accounts          Account[]
  sessions          Session[]
  courseProgress    CourseProgress[]
  simulatorProgress SimulatorProgress[]
  Activity          Activity[]
}

model ContactMessage {
  id        String   @id @default(cuid())
  nombre    String
  email     String
  motivo    String
  mensaje   String
  createdAt DateTime @default(now())
}

model Question {
  id         String   @id @default(uuid())
  statement  String
  options    String[]
  correct    Int
  university String
  subject    String
  createdAt  DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}